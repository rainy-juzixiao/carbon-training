+      </div>
+      <div class="cover" v-if="news.cover">
+        <img :src="coverUrl(news.cover)" alt="新闻封面" />
+      </div>
+      <div class="content" v-html="news.content"></div>
+      <div class="actions">
+        <el-button :type="liked ? 'info' : 'primary'" @click="handleLike">
+          {{ liked ? '取消点赞' : '点赞' }}
+        </el-button>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script>
+import { getHotnews, likeHotnews, unlikeHotnews } from '@/api/bid/hotnews'
+import { getToken } from '@/utils/auth'
+
+const CATEGORY_MAP = {
+  1: '政策动态',
+  2: '行业资讯',
+  3: '技术前沿',
+  4: '市场趋势',
+  5: '其他'
+}
+
+export default {
+  name: 'NewsDetail',
+  data() {
+    return {
+      news: {},
+      loading: false,
+      liked: false
+    }
+  },
+  mounted() {
+    this.getDetail()
+  },
+  methods: {
+    getDetail() {
+      const id = this.$route.query.id
+      if (!id) return
+      this.loading = true
+      getHotnews(id).then(res => {
+        this.news = res.data || {}
+        this.loading = false
+      }).catch(() => {
+        this.loading = false
+      })
+    },
+    categoryLabel(value) {
+      return CATEGORY_MAP[value] || ''
+    },
+    coverUrl(path) {
+      if (!path) return ''
+      if (path.startsWith('http')) return path
+      return import.meta.env.VITE_APP_BASE_API + path
+    },
+    handleLike() {
+      if (!getToken()) {
+        this.$message.warning('请先登录')
+        this.$router.push('/login?redirect=' + this.$route.fullPath)
+        return
+      }
+      const id = this.news.id
+      if (this.liked) {
+        unlikeHotnews(id).then(() => {
+          this.liked = false
+          this.news.likeCount = Math.max((this.news.likeCount || 0) - 1, 0)
+        })
+      } else {
+        likeHotnews(id).then(() => {
+          this.liked = true
+          this.news.likeCount = (this.news.likeCount || 0) + 1
+        })
+      }
+    }
+  }
+}
+</script>
