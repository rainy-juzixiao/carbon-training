+<?xml version="1.0" encoding="UTF-8" ?>
+<!DOCTYPE mapper
+PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
+"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
+<mapper namespace="com.neu.carbon.bid.mapper.BidHotNewsMapper">
+
+    <resultMap type="BidHotNews" id="BidHotNewsResult">
+        <result property="id"    column="id"    />
+        <result property="title"    column="title"    />
+        <result property="category"    column="category"    />
+        <result property="cover"    column="cover"    />
+        <result property="summary"    column="summary"    />
+        <result property="content"    column="content"    />
+        <result property="source"    column="source"    />
+        <result property="publisher"    column="publisher"    />
+        <result property="publishTime"    column="publish_time"    />
+        <result property="isTop"    column="is_top"    />
+        <result property="status"    column="status"    />
+        <result property="viewCount"    column="view_count"    />
+        <result property="likeCount"    column="like_count"    />
+        <result property="commentCount"    column="comment_count"    />
+        <result property="createBy"    column="create_by"    />
+        <result property="createTime"    column="create_time"    />
+        <result property="updateBy"    column="update_by"    />
+        <result property="updateTime"    column="update_time"    />
+        <result property="remark"    column="remark"    />
+    </resultMap>
+
+    <sql id="selectBidHotNewsVo">
+        select id, title, category, cover, summary, content, source, publisher, publish_time, is_top, status, view_count, like_count, comment_count, create_by, create_time, update_by, update_time, remark from bid_hot_news
+    </sql>
+
+    <select id="selectBidHotNewsList" parameterType="BidHotNews" resultMap="BidHotNewsResult">
+        <include refid="selectBidHotNewsVo"/>
+        <where>
+            <if test="title != null  and title != ''"> and title LIKE CONCAT('%',#{title},'%')</if>
+            <if test="category != null "> and category = #{category}</if>
+            <if test="source != null  and source != ''"> and source = #{source}</if>
+            <if test="publisher != null  and publisher != ''"> and publisher = #{publisher}</if>
+            <if test="isTop != null "> and is_top = #{isTop}</if>
+            <if test="status != null "> and status = #{status}</if>
+            <if test="params.beginTime != null and params.beginTime != ''"> and publish_time &gt;= #{params.beginTime}</if>
+            <if test="params.endTime != null and params.endTime != ''"> and publish_time &lt;= #{params.endTime}</if>
+        </where>
+        <choose>
+            <when test="params.orderBy == 'hot'">order by is_top desc, view_count desc</when>
+            <when test="params.orderBy == 'newest'">order by is_top desc, publish_time desc</when>
+            <otherwise>order by is_top desc, view_count desc, publish_time desc</otherwise>
+        </choose>
+    </select>
+
+    <select id="selectHotRankList" resultMap="BidHotNewsResult">
+        <include refid="selectBidHotNewsVo"/>
+        where status = 1
+        order by view_count desc
+        limit 10
+    </select>
+
+    <select id="selectBidHotNewsById" parameterType="Long" resultMap="BidHotNewsResult">
+        <include refid="selectBidHotNewsVo"/>
+        where id = #{id}
+    </select>
+
+    <insert id="insertBidHotNews" parameterType="BidHotNews" useGeneratedKeys="true" keyProperty="id">
+        insert into bid_hot_news
+        <trim prefix="(" suffix=")" suffixOverrides=",">
+            <if test="id != null">id,</if>
+            <if test="title != null and title != ''">title,</if>
+            <if test="category != null">category,</if>
+            <if test="cover != null">cover,</if>
+            <if test="summary != null">summary,</if>
+            <if test="content != null and content != ''">content,</if>
+            <if test="source != null">source,</if>
+            <if test="publisher != null">publisher,</if>
+            <if test="publishTime != null">publish_time,</if>
+            <if test="isTop != null">is_top,</if>
+            <if test="status != null">status,</if>
+            <if test="viewCount != null">view_count,</if>
+            <if test="likeCount != null">like_count,</if>
+            <if test="commentCount != null">comment_count,</if>
+            <if test="createBy != null">create_by,</if>
+            <if test="createTime != null">create_time,</if>
+            <if test="updateBy != null">update_by,</if>
+            <if test="updateTime != null">update_time,</if>
+            <if test="remark != null">remark,</if>
+         </trim>
+        <trim prefix="values (" suffix=")" suffixOverrides=",">
+            <if test="id != null">#{id},</if>
+            <if test="title != null and title != ''">#{title},</if>
+            <if test="category != null">#{category},</if>
+            <if test="cover != null">#{cover},</if>
+            <if test="summary != null">#{summary},</if>
+            <if test="content != null and content != ''">#{content},</if>
+            <if test="source != null">#{source},</if>
+            <if test="publisher != null">#{publisher},</if>
+            <if test="publishTime != null">#{publishTime},</if>
+            <if test="isTop != null">#{isTop},</if>
+            <if test="status != null">#{status},</if>
+            <if test="viewCount != null">#{viewCount},</if>
+            <if test="likeCount != null">#{likeCount},</if>
+            <if test="commentCount != null">#{commentCount},</if>
+            <if test="createBy != null">#{createBy},</if>
+            <if test="createTime != null">#{createTime},</if>
+            <if test="updateBy != null">#{updateBy},</if>
+            <if test="updateTime != null">#{updateTime},</if>
+            <if test="remark != null">#{remark},</if>
+         </trim>
+    </insert>
+
+    <update id="updateBidHotNews" parameterType="BidHotNews">
+        update bid_hot_news
+        <trim prefix="SET" suffixOverrides=",">
+            <if test="title != null and title != ''">title = #{title},</if>
+            <if test="category != null">category = #{category},</if>
+            <if test="cover != null">cover = #{cover},</if>
+            <if test="summary != null">summary = #{summary},</if>
+            <if test="content != null and content != ''">content = #{content},</if>
+            <if test="source != null">source = #{source},</if>
+            <if test="publisher != null">publisher = #{publisher},</if>
+            <if test="publishTime != null">publish_time = #{publishTime},</if>
+            <if test="isTop != null">is_top = #{isTop},</if>
+            <if test="status != null">status = #{status},</if>
+            <if test="viewCount != null">view_count = #{viewCount},</if>
+            <if test="likeCount != null">like_count = #{likeCount},</if>
+            <if test="commentCount != null">comment_count = #{commentCount},</if>
+            <if test="updateBy != null">update_by = #{updateBy},</if>
+            <if test="updateTime != null">update_time = #{updateTime},</if>
+            <if test="remark != null">remark = #{remark},</if>
+        </trim>
+        where id = #{id}
+    </update>
+
+    <update id="increaseViewCount" parameterType="Long">
+        update bid_hot_news set view_count = ifnull(view_count, 0) + 1 where id = #{id}
+    </update>
+
+    <update id="increaseLikeCount" parameterType="Long">
+        update bid_hot_news set like_count = ifnull(like_count, 0) + 1 where id = #{id}
+    </update>
+
+    <update id="decreaseLikeCount" parameterType="Long">
+        update bid_hot_news set like_count = if(ifnull(like_count, 0) &gt; 0, like_count - 1, 0) where id = #{id}
+    </update>
+
+    <update id="updateStatusByIds">
+        update bid_hot_news set status = #{status} where id in
+        <foreach item="id" collection="ids" open="(" separator="," close=")">
+            #{id}
+        </foreach>
+    </update>
+
+    <delete id="deleteBidHotNewsById" parameterType="Long">
+        delete from bid_hot_news where id = #{id}
+    </delete>
+
+    <delete id="deleteBidHotNewsByIds" parameterType="String">
+        delete from bid_hot_news where id in
+        <foreach item="id" collection="array" open="(" separator="," close=")">
+            #{id}
+        </foreach>
+    </delete>
+
+</mapper>
