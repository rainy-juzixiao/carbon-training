+-- ----------------------------
+-- 任务5 热点新闻
+-- ----------------------------
+
+DROP TABLE IF EXISTS `bid_hot_news`;
+CREATE TABLE `bid_hot_news` (
+  `id` bigint NOT NULL COMMENT '主键',
+  `title` varchar(200) NOT NULL DEFAULT '' COMMENT '新闻标题',
+  `category` smallint NOT NULL DEFAULT 1 COMMENT '新闻分类 1政策动态 2行业资讯 3技术前沿 4市场趋势 5其他',
+  `cover` varchar(255) DEFAULT NULL COMMENT '新闻封面',
+  `summary` varchar(500) DEFAULT NULL COMMENT '新闻简介',
+  `content` longtext NOT NULL COMMENT '新闻正文',
+  `source` varchar(100) DEFAULT '' COMMENT '新闻来源',
+  `publisher` varchar(100) DEFAULT '' COMMENT '发布人',
+  `publish_time` datetime DEFAULT NULL COMMENT '发布时间',
+  `is_top` smallint DEFAULT 0 COMMENT '是否置顶 0否 1是',
+  `status` smallint DEFAULT 0 COMMENT '新闻状态 0草稿 1已发布 2已下线',
+  `view_count` int DEFAULT 0 COMMENT '浏览量',
+  `like_count` int DEFAULT 0 COMMENT '点赞量',
+  `comment_count` int DEFAULT 0 COMMENT '评论数',
+  `create_by` varchar(64) DEFAULT '' COMMENT '创建者',
+  `create_time` datetime DEFAULT NULL COMMENT '创建时间',
+  `update_by` varchar(64) DEFAULT '' COMMENT '更新者',
+  `update_time` datetime DEFAULT NULL COMMENT '更新时间',
+  `remark` varchar(500) DEFAULT '' COMMENT '备注',
+  PRIMARY KEY (`id`),
+  KEY `idx_hot_news_status` (`status`),
+  KEY `idx_hot_news_category` (`category`)
+) ENGINE = InnoDB DEFAULT CHARSET = utf8mb3 COMMENT = '热点新闻表';
+
+-- ----------------------------
+-- 初始数据 10 条
+-- ----------------------------
+INSERT INTO `bid_hot_news` (`id`, `title`, `category`, `cover`, `summary`, `content`, `source`, `publisher`, `publish_time`, `is_top`, `status`, `view_count`, `like_count`, `comment_count`, `create_by`, `create_time`) VALUES
+(9001, '全国碳市场扩容方案落地，钢铁建材行业纳入交易', 1, NULL, '生态环境部发布碳市场扩容实施细则，钢铁、建材行业将于年内纳入配额管理。', '<p>生态环境部近日印发全国碳排放权交易市场扩容实施细则，明确钢铁、建材两个行业将在年内分批纳入配额管理，覆盖重点排放单位超过三千家。</p><p>细则提出，新增行业采用基准法与历史法相结合的配额分配方式，并对先进产能给予适度倾斜。</p>', '生态环境部', 'admin', '2026-01-08 09:20:00', 1, 1, 1280, 96, 12, 'admin', '2026-01-08 09:20:00'),
+(9002, '绿色采购目录更新，低碳产品优先进入政府采购清单', 1, NULL, '财政部等三部门联合发布新版绿色采购目录，低碳产品被列为优先采购对象。', '<p>新版绿色采购目录在原有基础上新增十二个品类，覆盖办公设备、建筑材料与运输服务。</p><p>目录要求采购人在同等条件下优先选择碳足迹标签产品，并在评分环节设置绿色加分项。</p>', '财政部', 'admin', '2026-01-06 14:05:00', 0, 1, 964, 71, 8, 'admin', '2026-01-06 14:05:00'),
+(9003, '供应链碳排放核算标准征求意见，覆盖范围三排放', 1, NULL, '标准首次将范围三排放纳入核算要求，采购环节成为重点。', '<p>相关标准化技术委员会就供应链碳排放核算指南公开征求意见，指南首次将范围三排放明确纳入核算边界。</p><p>指南建议企业建立供应商碳排放数据台账，按采购金额与排放强度双重维度评估。</p>', '中国标准化研究院', 'admin', '2026-01-03 10:30:00', 0, 1, 812, 65, 5, 'admin', '2026-01-03 10:30:00'),
+(9004, '数字化采购平台渗透率突破四成，集采效率明显提升', 2, NULL, '行业报告显示企业数字化采购平台渗透率已达 42%，采购周期平均缩短三成。', '<p>最新行业报告指出，企业数字化采购平台渗透率已达百分之四十二，集中采购的平均周期缩短约三成。</p><p>报告同时提示，数据孤岛仍是制约采购数字化的主要障碍。</p>', '中国物流与采购联合会', 'admin', '2026-01-02 16:40:00', 1, 1, 1576, 132, 21, 'admin', '2026-01-02 16:40:00'),
+(9005, '中小企业采购数字化转型扶持计划启动', 2, NULL, '多地推出专项扶持计划，为中小企业采购系统改造提供补贴。', '<p>多地工信部门联合推出中小企业采购数字化转型扶持计划，对采购管理系统改造给予最高三成补贴。</p><p>计划首期覆盖五千家企业，重点支持电子招投标与供应商协同场景。</p>', '工业和信息化部', 'admin', '2025-12-30 11:15:00', 0, 1, 683, 48, 4, 'admin', '2025-12-30 11:15:00'),
+(9006, '电子招投标全流程在线化率超过九成', 2, NULL, '公共资源交易平台数据显示电子招投标全流程在线化率已达 91%。', '<p>全国公共资源交易平台统计显示，电子招投标全流程在线化率已达百分之九十一，纸质标书基本退出主流场景。</p><p>远程异地评标覆盖率同步提升，跨区域协同评审成为常态。</p>', '国家发展改革委', 'admin', '2025-12-26 09:00:00', 0, 1, 541, 33, 2, 'admin', '2025-12-26 09:00:00'),
+(9007, '区块链存证技术在采购合同场景规模化应用', 3, NULL, '多家企业将区块链存证用于采购合同签署，纠纷处理周期显著缩短。', '<p>区块链存证技术已在采购合同签署环节实现规模化应用，合同验签时间从数天缩短至分钟级。</p><p>应用方表示，存证节点覆盖采购方、供应商与第三方审计机构。</p>', '中国电子技术标准化研究院', 'admin', '2025-12-22 15:30:00', 0, 1, 1204, 108, 16, 'admin', '2025-12-22 15:30:00'),
+(9008, '智能比价模型上线，采购寻源效率提升五成', 3, NULL, '基于历史成交数据的智能比价模型投入使用，寻源环节耗时明显下降。', '<p>基于历史成交数据训练的智能比价模型正式上线，可在寻源阶段自动生成价格区间建议。</p><p>试点企业反馈，寻源环节平均耗时下降约五成。</p>', '中国招标投标协会', 'admin', '2025-12-18 13:20:00', 0, 1, 742, 59, 7, 'admin', '2025-12-18 13:20:00'),
+(9009, '钢材价格震荡上行，采购端锁价策略受关注', 4, NULL, '受原料成本推动钢材价格震荡上行，采购端锁价与长约策略受到关注。', '<p>近期钢材价格震荡上行，采购企业开始通过锁价合同与长约协议对冲价格波动风险。</p><p>分析人士建议结合库存周转率动态调整采购节奏。</p>', '中国钢铁工业协会', 'admin', '2025-12-15 10:10:00', 0, 1, 918, 62, 9, 'admin', '2025-12-15 10:10:00'),
+(9010, '绿色低碳产品采购规模同比增长三成', 5, NULL, '统计显示绿色低碳产品采购规模同比增长 30%，环保设备增幅居前。', '<p>年度统计数据显示，绿色低碳产品采购规模同比增长百分之三十，其中环保设备与节能电机增幅居前。</p><p>采购方普遍将碳足迹指标纳入供应商准入条件。</p>', '中国采购与招标网', 'admin', '2025-12-10 08:45:00', 0, 0, 0, 0, 0, 'admin', '2025-12-10 08:45:00');
+
