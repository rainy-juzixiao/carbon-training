+          <span>发布人：{{ detail.publisher }}</span>
+          <span>发布时间：{{ parseTime(detail.publishTime, '{y}-{m}-{d} {h}:{i}') }}</span>
+          <span>浏览量：{{ detail.viewCount }}</span>
+          <span>点赞量：{{ detail.likeCount }}</span>
+          <span>评论数：{{ detail.commentCount }}</span>
+        </div>
+        <div class="detail-cover" v-if="detail.cover">
+          <img :src="coverUrl(detail.cover)" alt="新闻封面" />
+        </div>
+        <div class="detail-content" v-html="detail.content"></div>
+      </div>
+    </el-dialog>
+  </div>
+</template>
+
+<script setup name="Hotnews">
+import { listHotnews, getHotnews, addHotnews, updateHotnews, delHotnews, publishHotnews, offlineHotnews } from "@/api/bid/hotnews";
+
+const { proxy } = getCurrentInstance();
+
+const categoryOptions = [
+  { value: 1, label: "政策动态" },
+  { value: 2, label: "行业资讯" },
+  { value: 3, label: "技术前沿" },
+  { value: 4, label: "市场趋势" },
+  { value: 5, label: "其他" }
+];
+const statusOptions = [
+  { value: 0, label: "草稿" },
+  { value: 1, label: "已发布" },
+  { value: 2, label: "已下线" }
+];
+const publisherOptions = ["admin"];
+
+const newsList = ref([]);
+const open = ref(false);
+const viewOpen = ref(false);
+const loading = ref(true);
+const showSearch = ref(true);
+const ids = ref([]);
+const multiple = ref(true);
+const total = ref(0);
+const title = ref("");
+const dateRange = ref([]);
+const detail = ref({});
+
+const data = reactive({
+  form: {},
+  queryParams: {
+    pageNum: 1,
+    pageSize: 10,
+    title: undefined,
+    category: undefined,
+    source: undefined,
+    publisher: undefined,
+    status: undefined,
+    isTop: undefined
+  },
+  rules: {
+    title: [{ required: true, message: "新闻标题不能为空", trigger: "blur" }],
+    category: [{ required: true, message: "新闻分类不能为空", trigger: "change" }],
+    content: [{ required: true, message: "新闻正文不能为空", trigger: "blur" }]
+  }
+});
+
+const { queryParams, form, rules } = toRefs(data);
+
+function coverUrl(path) {
+  if (!path) return "";
+  if (path.startsWith("http")) return path;
+  return import.meta.env.VITE_APP_BASE_API + path;
+}
+
+function categoryLabel(value) {
+  const item = categoryOptions.find(o => o.value === value);
+  return item ? item.label : "";
+}
+
+function statusLabel(value) {
+  const item = statusOptions.find(o => o.value === value);
+  return item ? item.label : "";
+}
+
+function statusTagType(value) {
+  if (value === 1) return "success";
+  if (value === 2) return "info";
+  return "warning";
+}
+
+/** 查询新闻列表 */
+function getList() {
+  loading.value = true;
+  const params = { ...queryParams.value };
+  if (dateRange.value && dateRange.value.length === 2) {
+    params.params = { beginTime: dateRange.value[0] + " 00:00:00", endTime: dateRange.value[1] + " 23:59:59" };
+  }
+  listHotnews(params).then(response => {
+    newsList.value = response.rows;
+    total.value = response.total;
+    loading.value = false;
+  });
+}
+
+/** 取消按钮 */
+function cancel() {
+  open.value = false;
+  reset();
+}
+
+/** 表单重置 */
+function reset() {
+  form.value = {
+    id: undefined,
+    title: undefined,
+    category: undefined,
+    cover: undefined,
+    summary: undefined,
+    content: undefined,
+    source: undefined,
+    publisher: undefined,
+    isTop: 0,
+    status: 0
+  };
+  proxy.resetForm("newsRef");
+}
+
+/** 搜索按钮操作 */
+function handleQuery() {
+  queryParams.value.pageNum = 1;
+  getList();
+}
+
+/** 重置按钮操作 */
+function resetQuery() {
+  dateRange.value = [];
+  proxy.resetForm("queryRef");
+  handleQuery();
+}
+
+/** 多选框选中数据 */
+function handleSelectionChange(selection) {
+  ids.value = selection.map(item => item.id);
+  multiple.value = !selection.length;
+}
+
+/** 新增按钮操作 */
+function handleAdd() {
+  reset();
+  open.value = true;
+  title.value = "新增新闻";
+}
+
+/** 编辑按钮操作 */
+function handleUpdate(row) {
+  reset();
+  const id = row.id || ids.value[0];
+  getHotnews(id).then(response => {
+    form.value = response.data;
+    open.value = true;
+    title.value = "编辑新闻";
+  });
+}
+
+/** 查看按钮操作 */
+function handleView(row) {
+  getHotnews(row.id).then(response => {
+    detail.value = response.data;
+    viewOpen.value = true;
+  });
+}
+
+/** 提交按钮，status 为保存后的新闻状态 */
+function submitForm(status) {
+  proxy.$refs["newsRef"].validate(valid => {
+    if (!valid) return;
+    form.value.status = status;
+    if (form.value.id != undefined) {
+      updateHotnews(form.value).then(() => {
+        proxy.$modal.msgSuccess("修改成功");
+        open.value = false;
+        getList();
+      });
+    } else {
+      addHotnews(form.value).then(() => {
+        proxy.$modal.msgSuccess(status === 1 ? "发布成功" : "草稿保存成功");
+        open.value = false;
+        getList();
+      });
+    }
+  });
+}
+
+/** 删除按钮操作 */
+function handleDelete(row) {
+  const delIds = row.id ? [row.id] : ids.value;
+  const tip = row.id
+    ? `确认删除新闻《${row.title}》？`
+    : `确认删除选中的 ${delIds.length} 条新闻？`;
+  proxy.$modal.confirm(tip).then(() => {
+    return delHotnews(delIds.join(","));
+  }).then(() => {
+    getList();
+    proxy.$modal.msgSuccess("删除成功");
+  }).catch(() => {});
+}
+
+/** 批量发布 */
+function handleBatchPublish() {
+  proxy.$modal.confirm(`确认发布选中的 ${ids.value.length} 条新闻？`).then(() => {
+    return publishHotnews(ids.value.join(","));
+  }).then(() => {
+    getList();
+    proxy.$modal.msgSuccess("发布成功");
+  }).catch(() => {});
+}
+
+/** 批量下线 */
+function handleBatchOffline() {
+  proxy.$modal.confirm(`确认下线选中的 ${ids.value.length} 条新闻？`).then(() => {
+    return offlineHotnews(ids.value.join(","));
+  }).then(() => {
+    getList();
+    proxy.$modal.msgSuccess("下线成功");
+  }).catch(() => {});
+}
+
+getList();
+</script>
+
+<style scoped>
+.news-detail {
+  padding: 0 10px;
+}
+.detail-title {
+  font-size: 22px;
+  margin: 0 0 12px;
+  text-align: center;
+}
+.detail-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  justify-content: center;
+  color: #909399;
+  font-size: 13px;
+  padding-bottom: 12px;
+  border-bottom: 1px solid #ebeef5;
+}
+.detail-cover {
+  text-align: center;
+  margin: 16px 0;
+}
+.detail-cover img {
+  max-width: 100%;
+  max-height: 320px;
+}
+.detail-content {
+  line-height: 1.8;
+  font-size: 15px;
+  color: #303133;
+}
+</style>
