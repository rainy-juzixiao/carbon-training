+package com.neu.carbon.bid.service.impl;
+
+import java.util.List;
+
+import cn.hutool.core.util.IdUtil;
+import com.neu.common.utils.DateUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Service;
+import com.neu.carbon.bid.mapper.BidHotNewsMapper;
+import com.neu.carbon.bid.domain.BidHotNews;
+import com.neu.carbon.bid.service.IBidHotNewsService;
+
+/**
+ * 热点新闻Service业务层处理
+ *
+ * @author neuedu
+ * @date 2026-01-08
+ */
+@Service
+public class BidHotNewsServiceImpl implements IBidHotNewsService
+{
+    @Autowired
+    private BidHotNewsMapper bidHotNewsMapper;
+
+    /**
+     * 查询热点新闻
+     *
+     * @param id 热点新闻主键
+     * @return 热点新闻
+     */
+    @Override
+    public BidHotNews selectBidHotNewsById(Long id)
+    {
+        return bidHotNewsMapper.selectBidHotNewsById(id);
+    }
+
+    /**
+     * 查询热点新闻列表
+     *
+     * @param bidHotNews 热点新闻
+     * @return 热点新闻
+     */
+    @Override
+    public List<BidHotNews> selectBidHotNewsList(BidHotNews bidHotNews)
+    {
+        return bidHotNewsMapper.selectBidHotNewsList(bidHotNews);
+    }
+
+    /**
+     * 查询热点排行
+     *
+     * @return 热点新闻集合
+     */
+    @Override
+    public List<BidHotNews> selectHotRankList()
+    {
+        return bidHotNewsMapper.selectHotRankList();
+    }
+
+    /**
+     * 新增热点新闻
+     *
+     * @param bidHotNews 热点新闻
+     * @return 结果
+     */
+    @Override
+    public int insertBidHotNews(BidHotNews bidHotNews)
+    {
+        bidHotNews.setCreateTime(DateUtils.getNowDate());
+        bidHotNews.setId(IdUtil.getSnowflake(1, 1).nextId());
+        if (bidHotNews.getPublishTime() == null)
+        {
+            bidHotNews.setPublishTime(DateUtils.getNowDate());
+        }
+        if (bidHotNews.getViewCount() == null)
+        {
+            bidHotNews.setViewCount(0);
+        }
+        if (bidHotNews.getLikeCount() == null)
+        {
+            bidHotNews.setLikeCount(0);
+        }
+        if (bidHotNews.getCommentCount() == null)
+        {
+            bidHotNews.setCommentCount(0);
+        }
+        return bidHotNewsMapper.insertBidHotNews(bidHotNews);
+    }
+
+    /**
+     * 修改热点新闻
+     *
+     * @param bidHotNews 热点新闻
+     * @return 结果
+     */
+    @Override
+    public int updateBidHotNews(BidHotNews bidHotNews)
+    {
+        bidHotNews.setUpdateTime(DateUtils.getNowDate());
+        return bidHotNewsMapper.updateBidHotNews(bidHotNews);
+    }
+
+    /**
+     * 批量删除热点新闻
+     *
+     * @param ids 需要删除的热点新闻主键
+     * @return 结果
+     */
+    @Override
+    public int deleteBidHotNewsByIds(Long[] ids)
+    {
+        return bidHotNewsMapper.deleteBidHotNewsByIds(ids);
+    }
+
+    /**
+     * 删除热点新闻信息
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    @Override
+    public int deleteBidHotNewsById(Long id)
+    {
+        return bidHotNewsMapper.deleteBidHotNewsById(id);
+    }
+
+    /**
+     * 浏览量加一
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    @Override
+    public int increaseViewCount(Long id)
+    {
+        return bidHotNewsMapper.increaseViewCount(id);
+    }
+
+    /**
+     * 点赞
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    @Override
+    public int like(Long id)
+    {
+        return bidHotNewsMapper.increaseLikeCount(id);
+    }
+
+    /**
+     * 取消点赞
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    @Override
+    public int unlike(Long id)
+    {
+        return bidHotNewsMapper.decreaseLikeCount(id);
+    }
+
+    /**
+     * 批量修改新闻状态
+     *
+     * @param ids 主键集合
+     * @param status 新闻状态
+     * @return 结果
+     */
+    @Override
+    public int updateStatusByIds(Long[] ids, Integer status)
+    {
+        return bidHotNewsMapper.updateStatusByIds(ids, status);
+    }
+}
