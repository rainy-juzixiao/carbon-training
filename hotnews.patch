new file mode 100644
index 0000000..4de2a26
--- /dev/null
+++ b/frontend_user/src/views/news/components/DragCard.vue
@@ -0,0 +1,143 @@
+<template>
+  <div ref="rootEl" class="drag-slot" :style="slotStyle">
+    <div class="drag-card" :class="{ 'is-fixed': positioned, 'is-collapsed': collapsed }" :style="cardStyle"
+      @click="handleCardClick">
+      <div class="drag-header" @mousedown="handleMouseDown">
+        <slot name="header" />
+      </div>
+      <div class="drag-body">
+        <slot />
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+const rootEl = ref(null);
+
+let startX = 0;
+let startY = 0;
+let isDragging = false;
+
+const positioned = ref(false);
+const side = ref('none');
+const left = ref(0)
+const top = ref(0)
+const width = ref(0)
+const height = ref(0)
+
+const slotStyle = computed(() => {
+  if (!positioned.value) return {}
+  return { width: `${width.value}px`, height: `${height.value}px` }
+})
+
+const cardStyle = computed(() => {
+  if (!positioned.value) return {}
+  const style = { position: 'fixed', left: `${left.value}px`, /* ... */ }
+  if (collapsed.value) {
+    style.transform = side.value === 'left'
+      ? 'translateX(calc(-100% + 12px))'
+      : 'translateX(calc(100% - 12px))'
+  }
+  return style
+});
+
+function handleMouseDown(e) {
+  if (e.button !== 0) {
+    return;
+  }
+  const el = rootEl.value;
+  if (!el) {
+    return;
+  }
+  const rect = el.getBoundingClientRect()
+  width.value = rect.width;
+  height.value = rect.height;
+  left.value = rect.left;
+  top.value = rect.top;
+  positioned.value = true;
+  collapsed.value = false;
+
+  isDragging = true;
+  moved = false;
+  startX = e.clientX;
+  startY = e.clientY;
+  startLeft = rect.left;
+  startTop = rect.top;
+
+  document.addEventListener('mousemove', handleMouseMove);
+  document.addEventListener('mouseup', handleMouseUp);
+}
+function handleMouseMove(e) {
+  if (!isDragging) return
+  e.preventDefault()
+
+  const dx = e.clientX - startX
+  const dy = e.clientY - startY
+  if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true
+
+  left.value = startLeft + dx
+  top.value = startTop + dy
+}
+
+function handleMouseUp() {
+  if (!isDragging) return
+  isDragging = false
+
+  document.documentElement.removeEventListener('mousemove', handleMouseMove)
+  document.documentElement.removeEventListener('mouseup', handleMouseUp)
+
+  const pageWidth = document.documentElement.clientWidth
+
+  if (left.value <= 50) {
+    left.value = 0
+    side.value = 'left'
+    collapsed.value = true
+  } else if (left.value + width.value >= pageWidth - 50) {
+    left.value = pageWidth - width.value
+    side.value = 'right'
+    collapsed.value = true
+  }
+}
+
+function handleCardClick() {
+  if (moved) {
+    moved = false
+    return
+  }
+  if (collapsed.value) collapsed.value = false
+}
+
+onBeforeUnmount(() => {
+  document.documentElement.removeEventListener('mousemove', handleMouseMove)
+  document.documentElement.removeEventListener('mouseup', handleMouseUp)
+})
+
+</script>
+
+<style scoped>
+.drag-slot {
+  flex: none;
+}
+
+.drag-card {
+  background: #ffffff;
+  border-radius: 12px;
+  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
+  overflow: hidden;
+}
+
+.drag-card.is-collapsed {
+  transition: transform 0.25s;
+  cursor: pointer;
+}
+
+.drag-header {
+  cursor: move;
+  user-select: none;
+}
+
+.drag-body {
+  padding: 0 12px 12px;
+}
+</style>
