+    <!-- 右：热点排行 -->
+    <drag-card class="col-rank">
+      <template #header>
+        <div class="card-head">热点排行</div>
+      </template>
+      <ul class="rank-list">
+        <li v-for="(item, index) in rankList" :key="item.id" @click="goDetail(item.id)">
+          <span class="rank-no" :class="'rank-' + (index + 1)">top{{ index + 1 }}</span>
+          <span class="rank-title">{{ item.title }}</span>
+        </li>
+      </ul>
+    </drag-card>
+
+    <!-- 悬浮图标 -->
+    <div
+      class="float-icon"
+      :style="{ left: floatLeft + 'px', top: floatTop + 'px' }"
+      @mousedown="handleFloatDown"
+      @contextmenu.prevent="lockScreen"
+    >
+      <img src="@/assets/images/pic5.png" alt="" />
+    </div>
+
+    <!-- 屏幕锁定 -->
+    <div v-if="locked" class="lock-screen">
+      <img src="@/assets/images/pic1.png" alt="" />
+      <div class="lock-tip">按 ESC 解锁</div>
+    </div>
+  </div>
+</template>
+
+<script>
+import DragCard from './components/DragCard.vue'
+import { listHotnews, getHotRank } from '@/api/bid/hotnews'
+import defaultCover from '@/assets/images/pic-cover.png'
+
+export default {
+  name: 'NewsHome',
+  components: { DragCard },
+  data() {
+    return {
+      categories: [
+        { value: 1, label: '政策动态', icon: 'Document' },
+        { value: 2, label: '行业资讯', icon: 'Reading' },
+        { value: 3, label: '技术前沿', icon: 'Cpu' },
+        { value: 4, label: '市场趋势', icon: 'TrendCharts' },
+        { value: 5, label: '其他', icon: 'More' }
+      ],
+      activeCategory: 1,
+      activeTab: 'recommend',
+      keyword: '',
+      newsList: [],
+      rankList: [],
+      loading: false,
+      locked: false,
+      floatLeft: 0,
+      floatTop: 0,
+      floatDragging: false,
+      floatStartX: 0,
+      floatStartY: 0,
+      floatStartLeft: 0,
+      floatStartTop: 0
+    }
+  },
+  mounted() {
+    this.floatLeft = document.documentElement.clientWidth - 60
+    this.floatTop = document.documentElement.clientHeight - 100
+    window.addEventListener('keydown', this.handleKeydown)
+    this.getNewsList()
+    this.getRankList()
+  },
+  beforeUnmount() {
+    window.removeEventListener('keydown', this.handleKeydown)
+    document.documentElement.removeEventListener('mousemove', this.handleFloatMove)
+    document.documentElement.removeEventListener('mouseup', this.handleFloatUp)
+  },
+  methods: {
+    getNewsList() {
+      this.loading = true
+      listHotnews({
+        pageNum: 1,
+        pageSize: 20,
+        category: this.activeCategory,
+        title: this.keyword,
+        params: { orderBy: this.activeTab }
+      }).then(res => {
+        this.newsList = res.rows
+        this.loading = false
+      }).catch(() => {
+        this.loading = false
+      })
+    },
+    getRankList() {
+      getHotRank().then(res => {
+        this.rankList = res.data || []
+      })
+    },
+    handleCategory(value) {
+      this.activeCategory = value
+      this.getNewsList()
+    },
+    handleTabClick() {
+      this.getNewsList()
+    },
+    goDetail(id) {
+      this.$router.push({ path: '/news/detail', query: { id } })
+    },
+    coverUrl(path) {
+      if (!path) return defaultCover
+      if (path.startsWith('http')) return path
+      return import.meta.env.VITE_APP_BASE_API + path
+    },
+    handleFloatDown(e) {
+      if (e.button !== 0) return
+      this.floatDragging = true
+      this.floatStartX = e.clientX
+      this.floatStartY = e.clientY
+      this.floatStartLeft = this.floatLeft
+      this.floatStartTop = this.floatTop
+      document.documentElement.addEventListener('mousemove', this.handleFloatMove)
+      document.documentElement.addEventListener('mouseup', this.handleFloatUp)
+    },
+    handleFloatMove(e) {
+      if (!this.floatDragging) return
+      e.preventDefault()
+      const maxLeft = document.documentElement.clientWidth - 40
+      const maxTop = document.documentElement.clientHeight - 40
+      this.floatLeft = Math.min(Math.max(this.floatStartLeft + e.clientX - this.floatStartX, 0), maxLeft)
+      this.floatTop = Math.min(Math.max(this.floatStartTop + e.clientY - this.floatStartY, 0), maxTop)
+    },
+    handleFloatUp() {
+      this.floatDragging = false
+      document.documentElement.removeEventListener('mousemove', this.handleFloatMove)
+      document.documentElement.removeEventListener('mouseup', this.handleFloatUp)
+    },
+    lockScreen() {
+      this.locked = true
+    },
+    handleKeydown(e) {
+      if (e.key === 'Escape' && this.locked) {
+        this.locked = false
+      }
+    }
+  }
+}
+</script>
