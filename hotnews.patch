+import request from '@/utils/request'
+
+// 查询热点新闻列表
+export function listHotnews(query) {
+  return request({
+    url: '/bid/hotnews/list',
+    method: 'get',
+    params: query
+  })
+}
+
+// 查询热点新闻详细
+export function getHotnews(id) {
+  return request({
+    url: '/bid/hotnews/' + id,
+    method: 'get'
+  })
+}
+
+// 新增热点新闻
+export function addHotnews(data) {
+  return request({
+    url: '/bid/hotnews',
+    method: 'post',
+    data: data
+  })
+}
+
+// 修改热点新闻
+export function updateHotnews(data) {
+  return request({
+    url: '/bid/hotnews',
+    method: 'put',
+    data: data
+  })
+}
+
+// 删除热点新闻
+export function delHotnews(id) {
+  return request({
+    url: '/bid/hotnews/' + id,
+    method: 'delete'
+  })
+}
+
+// 批量发布
+export function publishHotnews(ids) {
+  return request({
+    url: '/bid/hotnews/publish/' + ids,
+    method: 'put'
+  })
+}
+
+// 批量下线
+export function offlineHotnews(ids) {
+  return request({
+    url: '/bid/hotnews/offline/' + ids,
+    method: 'put'
+  })
+}
+
+// 导出热点新闻
+export function exportHotnews(query) {
+  return request({
+    url: '/bid/hotnews/export',
+    method: 'get',
+    params: query
+  })
+}
