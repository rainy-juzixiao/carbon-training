+package com.neu.carbon.bid.mapper;
+
+import java.util.List;
+import org.apache.ibatis.annotations.Param;
+import com.neu.carbon.bid.domain.BidHotNews;
+
+/**
+ * 热点新闻Mapper接口
+ *
+ * @author neuedu
+ * @date 2026-01-08
+ */
+public interface BidHotNewsMapper
+{
+    /**
+     * 查询热点新闻
+     *
+     * @param id 热点新闻主键
+     * @return 热点新闻
+     */
+    public BidHotNews selectBidHotNewsById(Long id);
+
+    /**
+     * 查询热点新闻列表
+     *
+     * @param bidHotNews 热点新闻
+     * @return 热点新闻集合
+     */
+    public List<BidHotNews> selectBidHotNewsList(BidHotNews bidHotNews);
+
+    /**
+     * 查询热点排行（已发布，按浏览量倒序取前十条）
+     *
+     * @return 热点新闻集合
+     */
+    public List<BidHotNews> selectHotRankList();
+
+    /**
+     * 新增热点新闻
+     *
+     * @param bidHotNews 热点新闻
+     * @return 结果
+     */
+    public int insertBidHotNews(BidHotNews bidHotNews);
+
+    /**
+     * 修改热点新闻
+     *
+     * @param bidHotNews 热点新闻
+     * @return 结果
+     */
+    public int updateBidHotNews(BidHotNews bidHotNews);
+
+    /**
+     * 删除热点新闻
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    public int deleteBidHotNewsById(Long id);
+
+    /**
+     * 批量删除热点新闻
+     *
+     * @param ids 需要删除的数据主键集合
+     * @return 结果
+     */
+    public int deleteBidHotNewsByIds(Long[] ids);
+
+    /**
+     * 浏览量加一
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    public int increaseViewCount(Long id);
+
+    /**
+     * 点赞量加一
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    public int increaseLikeCount(Long id);
+
+    /**
+     * 点赞量减一
+     *
+     * @param id 热点新闻主键
+     * @return 结果
+     */
+    public int decreaseLikeCount(Long id);
+
+    /**
+     * 批量修改新闻状态
+     *
+     * @param ids 主键集合
+     * @param status 新闻状态
+     * @return 结果
+     */
+    public int updateStatusByIds(@Param("ids") Long[] ids, @Param("status") Integer status);
+}
