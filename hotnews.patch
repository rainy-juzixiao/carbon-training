+package com.neu.carbon.bid.controller;
+
+import java.util.List;
+
+import com.neu.carbon.bid.domain.BidHotNews;
+import com.neu.carbon.bid.service.IBidHotNewsService;
+import com.neu.common.annotation.Log;
+import com.neu.common.core.controller.BaseController;
+import com.neu.common.core.domain.AjaxResult;
+import com.neu.common.core.page.TableDataInfo;
+import com.neu.common.enums.BusinessType;
+import com.neu.common.utils.poi.ExcelUtil;
+import io.swagger.annotations.Api;
+import io.swagger.annotations.ApiOperation;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.*;
+
+/**
+ * 热点新闻Controller
+ *
+ * @author neuedu
+ * @date 2026-01-08
+ */
+@Api(tags = {"招投标-热点新闻"})
+@RestController
+@RequestMapping("/bid/hotnews")
+public class BidHotNewsController extends BaseController
+{
+    @Autowired
+    private IBidHotNewsService bidHotNewsService;
+
+    /**
+     * 查询热点新闻列表
+     */
+    @ApiOperation("查询热点新闻列表")
+    @GetMapping("/list")
+    public TableDataInfo list(BidHotNews bidHotNews)
+    {
+        startPage();
+        List<BidHotNews> list = bidHotNewsService.selectBidHotNewsList(bidHotNews);
+        return getDataTable(list);
+    }
+
+    /**
+     * 用户端查询新闻列表（仅已发布）
+     */
+    @ApiOperation("用户端查询新闻列表")
+    @GetMapping("/front/list")
+    public TableDataInfo frontList(BidHotNews bidHotNews)
+    {
+        bidHotNews.setStatus(1);
+        startPage();
+        List<BidHotNews> list = bidHotNewsService.selectBidHotNewsList(bidHotNews);
+        return getDataTable(list);
+    }
+
+    /**
+     * 用户端查询热点排行
+     */
+    @ApiOperation("用户端查询热点排行")
+    @GetMapping("/front/rank")
+    public AjaxResult frontRank()
+    {
+        return AjaxResult.success(bidHotNewsService.selectHotRankList());
+    }
+
+    /**
+     * 用户端查询新闻详情（浏览量加一）
+     */
+    @ApiOperation("用户端查询新闻详情")
+    @GetMapping("/front/{id}")
+    public AjaxResult frontGetInfo(@PathVariable("id") Long id)
+    {
+        bidHotNewsService.increaseViewCount(id);
+        return AjaxResult.success(bidHotNewsService.selectBidHotNewsById(id));
+    }
+
+    /**
+     * 用户端点赞
+     */
+    @ApiOperation("用户端点赞")
+    @PostMapping("/front/like/{id}")
+    public AjaxResult frontLike(@PathVariable("id") Long id)
+    {
+        return toAjax(bidHotNewsService.like(id));
+    }
+
+    /**
+     * 用户端取消点赞
+     */
+    @ApiOperation("用户端取消点赞")
+    @PostMapping("/front/unlike/{id}")
+    public AjaxResult frontUnlike(@PathVariable("id") Long id)
+    {
+        return toAjax(bidHotNewsService.unlike(id));
+    }
+
+    /**
+     * 导出热点新闻列表
+     */
+    @PreAuthorize("@ss.hasPermi('bid:hotnews:export')")
+    @Log(title = "热点新闻", businessType = BusinessType.EXPORT)
+    @GetMapping("/export")
+    public AjaxResult export(BidHotNews bidHotNews)
+    {
+        List<BidHotNews> list = bidHotNewsService.selectBidHotNewsList(bidHotNews);
+        ExcelUtil<BidHotNews> util = new ExcelUtil<BidHotNews>(BidHotNews.class);
+        return util.exportExcel(list, "hotnews");
+    }
+
+    /**
+     * 获取热点新闻详细信息
+     */
+    @ApiOperation("获取热点新闻详细信息")
+    @GetMapping(value = "/{id}")
+    public AjaxResult getInfo(@PathVariable("id") Long id)
+    {
+        return AjaxResult.success(bidHotNewsService.selectBidHotNewsById(id));
+    }
+
+    /**
+     * 新增热点新闻
+     */
+    @PreAuthorize("@ss.hasPermi('bid:hotnews:add')")
+    @Log(title = "热点新闻", businessType = BusinessType.INSERT)
+    @PostMapping
+    public AjaxResult add(@RequestBody BidHotNews bidHotNews)
+    {
+        return toAjax(bidHotNewsService.insertBidHotNews(bidHotNews));
+    }
+
+    /**
+     * 修改热点新闻
+     */
+    @PreAuthorize("@ss.hasPermi('bid:hotnews:edit')")
+    @Log(title = "热点新闻", businessType = BusinessType.UPDATE)
+    @PutMapping
+    public AjaxResult edit(@RequestBody BidHotNews bidHotNews)
+    {
+        return toAjax(bidHotNewsService.updateBidHotNews(bidHotNews));
+    }
+
+    /**
+     * 批量发布
+     */
+    @PreAuthorize("@ss.hasPermi('bid:hotnews:edit')")
+    @Log(title = "热点新闻", businessType = BusinessType.UPDATE)
+    @PutMapping("/publish/{ids}")
+    public AjaxResult publish(@PathVariable Long[] ids)
+    {
+        return toAjax(bidHotNewsService.updateStatusByIds(ids, 1));
+    }
+
+    /**
+     * 批量下线
+     */
+    @PreAuthorize("@ss.hasPermi('bid:hotnews:edit')")
+    @Log(title = "热点新闻", businessType = BusinessType.UPDATE)
+    @PutMapping("/offline/{ids}")
+    public AjaxResult offline(@PathVariable Long[] ids)
+    {
+        return toAjax(bidHotNewsService.updateStatusByIds(ids, 2));
+    }
+
+    /**
+     * 删除热点新闻
+     */
+    @PreAuthorize("@ss.hasPermi('bid:hotnews:remove')")
+    @Log(title = "热点新闻", businessType = BusinessType.DELETE)
+    @DeleteMapping("/{ids}")
+    public AjaxResult remove(@PathVariable Long[] ids)
+    {
+        return toAjax(bidHotNewsService.deleteBidHotNewsByIds(ids));
+    }
+}
