+
+    <div class="detail-card" v-if="news.id">
+      <h1 class="title">{{ news.title }}</h1>
+      <div class="meta">
+        <span>分类：{{ categoryLabel(news.category) }}</span>
+        <span>来源：{{ news.source }}</span>
+        <span>发布人：{{ news.publisher }}</span>
