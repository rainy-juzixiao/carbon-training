+import request from '@/utils/request'
+
+// 查询社区分类列表
+export function listCommunityCategory(query) {
+  return request({
+    url: '/cms/communityCategory/list',
+    method: 'get',
+    params: query
+  })
+}
+
+// 查询社区分类详细
+export function getCommunityCategory(id) {
+  return request({
+    url: '/cms/communityCategory/' + id,
+    method: 'get'
+  })
+}
+
+// 新增社区分类
+export function addCommunityCategory(data) {
+  return request({
+    url: '/cms/communityCategory',
+    method: 'post',
+    data: data
+  })
+}
+
+// 修改社区分类
+export function updateCommunityCategory(data) {
+  return request({
+    url: '/cms/communityCategory',
+    method: 'put',
+    data: data
+  })
+}
+
+// 删除社区分类
+export function delCommunityCategory(id) {
+  return request({
+    url: '/cms/communityCategory/' + id,
+    method: 'delete'
+  })
+}
+
+// 导出社区分类
+export function exportCommunityCategory(query) {
+  return request({
+    url: '/cms/communityCategory/export',
+    method: 'get',
+    params: query
+  })
+}
