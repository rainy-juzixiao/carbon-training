+++ b/frontend_administrator/src/views/cms/communityCategory1/index.vue
@@ -0,0 +1,206 @@
+<template>
+  <div class="app-container">
+    <el-table v-loading="loading" :data="categoryList">
+      <el-table-column label="编号" align="center" prop="id" width="100" />
+      <el-table-column label="icon" align="center" width="140">
+        <template #default="scope">
+          <el-icon :size="20" color="#17C2AA">
+            <component :is="iconOf(scope.row.icon)" />
+          </el-icon>
+        </template>
+      </el-table-column>
+      <el-table-column label="分类名称" align="center" prop="name" />
+      <el-table-column label="操作" align="center" width="200" class-name="small-padding fixed-width">
+        <template #default="scope">
+          <el-button link type="primary" icon="Edit" @click="handleUpdate(scope.row)">修改</el-button>
+          <el-button link type="primary" icon="Delete" @click="handleDelete(scope.row)">删除</el-button>
+        </template>
+      </el-table-column>
+    </el-table>
+
+    <pagination
+      v-show="total > 0"
+      :total="total"
+      v-model:page="queryParams.pageNum"
+      v-model:limit="queryParams.pageSize"
+      @pagination="getList"
+    />
+
+    <!-- 修改分类对话框 -->
+    <el-dialog title="修改分类名称" v-model="open" width="500px" append-to-body>
+      <el-form ref="categoryRef" :model="form" :rules="rules" label-width="90px">
+        <el-form-item label="icon图标" prop="icon">
+          <el-popover placement="bottom-start" :width="460" trigger="click" v-model:visible="iconVisible">
+            <template #reference>
+              <el-input v-model="form.icon" placeholder="请选择图标" readonly>
+                <template #prefix>
+                  <el-icon v-if="form.icon"><component :is="iconOf(form.icon)" /></el-icon>
+                </template>
+              </el-input>
+            </template>
+            <div class="icon-picker">
+              <el-input v-model="iconKeyword" placeholder="请输入图标名称" clearable />
+              <div class="icon-list">
+                <div
+                  v-for="name in filteredIcons"
+                  :key="name"
+                  class="icon-item"
+                  :class="{ active: form.icon === name }"
+                  @click="selectIcon(name)"
+                >
+                  <el-icon :size="18"><component :is="name" /></el-icon>
+                  <span>{{ name }}</span>
+                </div>
+              </div>
+            </div>
+          </el-popover>
+        </el-form-item>
+        <el-form-item label="分类名称" prop="name">
+          <el-input v-model="form.name" placeholder="请输入分类名称" />
+        </el-form-item>
+      </el-form>
+      <template #footer>
+        <div class="dialog-footer">
+          <el-button type="primary" @click="submitForm">确 定</el-button>
+          <el-button @click="cancel">取 消</el-button>
+        </div>
+      </template>
+    </el-dialog>
+  </div>
+</template>
+
+<script setup name="CommunityCategory">
+import * as ElIcons from '@element-plus/icons-vue'
+import { listCommunityCategory, updateCommunityCategory, delCommunityCategory } from '@/api/cms/communityCategory'
+
+const { proxy } = getCurrentInstance()
+
+const categoryList = ref([])
+const loading = ref(true)
+const total = ref(0)
+const open = ref(false)
+const iconVisible = ref(false)
+const iconKeyword = ref('')
+
+const iconNames = Object.keys(ElIcons).filter(name => typeof ElIcons[name] === 'object')
+const filteredIcons = computed(() => {
+  const kw = (iconKeyword.value || '').trim()
+  return kw ? iconNames.filter(name => name.toLowerCase().includes(kw.toLowerCase())) : iconNames
+})
+
+const data = reactive({
+  queryParams: {
+    pageNum: 1,
+    pageSize: 10
+  },
+  form: {},
+  rules: {
+    icon: [{ required: true, message: '请选择icon图标', trigger: 'change' }],
+    name: [{ required: true, message: '分类名称不能为空', trigger: 'blur' }]
+  }
+})
+
+const { queryParams, form, rules } = toRefs(data)
+
+function iconOf(name) {
+  return ElIcons[name] || ElIcons.Grid
+}
+
+function getList() {
+  loading.value = true
+  listCommunityCategory(queryParams.value).then(response => {
+    categoryList.value = response.rows
+    total.value = response.total
+    loading.value = false
+  }).catch(() => {
+    loading.value = false
+  })
+}
+
+function selectIcon(name) {
+  form.value.icon = name
+  iconVisible.value = false
+}
+
+function reset() {
+  form.value = {
+    id: null,
+    name: null,
+    icon: null
+  }
+  iconKeyword.value = ''
+  proxy.resetForm('categoryRef')
+}
+
+function handleUpdate(row) {
+  reset()
+  form.value = { id: row.id, name: row.name, icon: row.icon }
+  open.value = true
+}
+
+function cancel() {
+  open.value = false
+  reset()
+}
+
+function submitForm() {
+  proxy.$refs['categoryRef'].validate(valid => {
+    if (valid) {
+      updateCommunityCategory(form.value).then(() => {
+        proxy.$modal.msgSuccess('修改成功')
+        open.value = false
+        getList()
+      })
+    }
+  })
+}
+
+function handleDelete(row) {
+  proxy.$modal.confirm('是否确认删除编号为"' + row.id + '"的社区分类？').then(() => {
+    return delCommunityCategory(row.id)
+  }).then(() => {
+    getList()
+    proxy.$modal.msgSuccess('删除成功')
+  }).catch(() => {})
+}
+
+getList()
+</script>
+
+<style scoped lang="scss">
+.icon-picker {
+  .icon-list {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+    max-height: 260px;
+    overflow-y: auto;
+    margin-top: 10px;
+  }
+
+  .icon-item {
+    display: flex;
+    align-items: center;
+    gap: 4px;
+    width: 110px;
+    padding: 4px 6px;
+    font-size: 12px;
+    color: #606266;
+    border: 1px solid #ebeef5;
+    border-radius: 4px;
+    cursor: pointer;
+
+    span {
+      overflow: hidden;
+      text-overflow: ellipsis;
+      white-space: nowrap;
+    }
+
+    &:hover,
+    &.active {
+      color: #17c2aa;
+      border-color: #17c2aa;
+    }
+  }
+}
+</style>
