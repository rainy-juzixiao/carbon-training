+.community-post {
+  display: flex;
+  gap: 16px;
+  align-items: flex-start;
+}
+
+.table-wrap {
+  flex: 1;
+  min-width: 0;
+  background: #ffffff;
+  border-radius: 8px;
+  padding: 16px;
+}
+
+.post-cover {
+  width: 96px;
+  height: 60px;
+  border-radius: 4px;
+}
+
+.palette {
+  width: 150px;
+  flex-shrink: 0;
+  background: #ffffff;
+  border-radius: 8px;
+  padding: 16px;
+  text-align: center;
+}
+
+.palette-title {
+  margin: 0 0 4px;
+  font-size: 14px;
+  font-weight: 600;
+  color: #303133;
+}
+
+.palette-tip {
+  margin: 0 0 12px;
+  font-size: 12px;
+  color: #909399;
+}
+
+.swatch {
+  height: 42px;
+  margin-bottom: 10px;
+  border-radius: 6px;
+  cursor: grab;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #ffffff;
+  font-size: 13px;
+  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
+  user-select: none;
+
+  &:active {
+    cursor: grabbing;
+  }
+}
+
+:deep(.post-row) {
+  transition: background-color 0.2s ease;
+}
