+        class="swatch"
+        :style="{ background: color.value }"
+        draggable="true"
+        :title="color.label"
+        @dragstart="handleDragStart($event, color.value)"
+      >
+        <span>{{ color.label }}</span>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup name="CommunityPost">
+import { ElMessageBox } from 'element-plus'
+import { listCommunityPost, delCommunityPost, updateCommunityPostRowColor } from '@/api/cms/communityPost'
+
+const { proxy } = getCurrentInstance()
+
+const coverModules = import.meta.glob('@/assets/images/community/cover*.png', { eager: true, import: 'default' })
+const coverMap = {}
+Object.keys(coverModules).forEach(key => {
+  coverMap[key.split('/').pop()] = coverModules[key]
+})
+
+function coverUrl(url) {
+  if (!url) return ''
+  if (/^https?:\/\//.test(url) || url.startsWith('data:')) return url
+  return coverMap[url.split('/').pop()] || ''
+}
+
+const postList = ref([])
+const loading = ref(true)
+const total = ref(0)
+
+const colors = [
+  { label: '红', value: '#F56C6C' },
+  { label: '橙', value: '#E6A23C' },
+  { label: '黄', value: '#F7D774' },
+  { label: '绿', value: '#67C23A' },
+  { label: '青', value: '#13C2C2' },
+  { label: '蓝', value: '#409EFF' },
+  { label: '紫', value: '#9B59B6' }
+]
+
+const data = reactive({
+  queryParams: {
+    pageNum: 1,
+    pageSize: 10
+  }
+})
+
+const { queryParams } = toRefs(data)
+
+function getList() {
+  loading.value = true
+  listCommunityPost(queryParams.value).then(response => {
+    postList.value = response.rows
+    total.value = response.total
+    loading.value = false
+  }).catch(() => {
+    loading.value = false
+  })
+}
+
+function rowClassName({ row }) {
+  return 'post-row post-row-' + row.id
+}
+
+function cellStyle({ row }) {
+  return row.rowColor ? { background: row.rowColor } : {}
+}
+
+let dragColor = null
+
+function handleDragStart(event, color) {
+  dragColor = color
+  event.dataTransfer.effectAllowed = 'copy'
+  event.dataTransfer.setData('text/plain', color)
+}
+
+function handleDrop(event) {
+  if (!dragColor) return
+  const tr = event.target.closest('tr')
+  if (!tr) return
+  const matched = Array.from(tr.classList).find(name => name.startsWith('post-row-'))
+  if (!matched) {
+    dragColor = null
+    return
+  }
+  const id = matched.replace('post-row-', '')
+  updateCommunityPostRowColor({ id, rowColor: dragColor }).then(() => {
+    const target = postList.value.find(item => String(item.id) === String(id))
+    if (target) {
+      target.rowColor = dragColor
+    }
+    proxy.$modal.msgSuccess('已保存行颜色');
+    getList();
+  })
+  dragColor = null
+}
+
+function handleDelete(row) {
+  ElMessageBox.confirm('是否删除' + row.id + '编号的帖子', '警告', {
+    confirmButtonText: '确定',
+    cancelButtonText: '取消',
+    type: 'warning'
+  }).then(() => {
+    return delCommunityPost(row.id)
+  }).then(() => {
+    getList()
+    proxy.$modal.msgSuccess('删除成功')
+  }).catch(() => {})
+}
+
+getList()
+</script>
+
