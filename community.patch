@@ -0,0 +1,211 @@
+<template>
+  <div class="app-container">
+    <div class="table-wrap" @dragover.prevent @drop="handleDrop">
+      <el-table :row-class-name="rowClassName" :cell-style="rowStyle" v-loading="loading" :data="communityPostList">
+        <el-table-column label="编号" align="center" prop="id"/>
+        <el-table-column label="标题" align="center" prop="title"/>
+        <el-table-column label="简介" align="center" prop="summary"/>
+        <el-table-column label="作者" align="center" prop="author"/>
+        <el-table-column label="帖子封面" align="center" prop="coverUrl">
+          <template #default="scope">
+            <el-image
+                v-if="scope.row.coverUrl"
+                fit="cover"
+                :src="coverUrl(scope.row.coverUrl)"
+            />
+            <span v-else>-</span>
+          </template>
+        </el-table-column>
+        <el-table-column label="浏览量" align="center" prop="viewCount"/>
+        <el-table-column label="点赞量" align="center" prop="likeCount"/>
+        <el-table-column label="状态" align="center" prop="status">
+          <template #default="scope">
+            <el-text v-if="scope.row.status === '0'">已发布</el-text>
+            <el-text v-else>已下架</el-text>
+          </template>
+        </el-table-column>
+        <el-table-column label="操作" align="center" width="110" class-name="small-padding fixed-width">
+          <template #default="scope">
+            <el-button link type="primary" icon="Delete" @click="handleDelete(scope.row)">删除</el-button>
+          </template>
+        </el-table-column>
+      </el-table>
+
+      <pagination
+          v-show="total>0"
+          :total="total"
+          v-model:page="queryParams.pageNum"
+          v-model:limit="queryParams.pageSize"
+          @pagination="getList"
+      />
+    </div>
+
+    <div class="palette">
+      <div
+          v-for="item in colors"
+          :key="item.color"
+          :style="{ background: item.color }"
+          draggable="true"
+          :title="item.color"
+          class="swatch"
+          @dragstart="handleDragStart($event, item.color)"
+      >
+        <span>{{ item.label }}</span>
+      </div>
+    </div>
+  </div>
+</template>
+<style lang="scss">
+.app-container {
+  display: flex;
+  gap: 16px;
+}
+
+.table-wrap {
+  min-width: 0;
+  flex: 1;
+  background: #ffffff;
+  border-radius: 8px;
+  padding: 16px;
+}
+
+.swatch {
+  height: 42px;
+  margin-bottom: 10px;
+  padding: 16px;
+  align-items: center;
+  justify-content: center;
+  border-radius: 6px;
+  display: flex;
+}
+
+.palette {
+  width: 150px;
+  justify-content: center;
+  align-items: center;
+}
+</style>
+<script setup name="CommunityPost">
+import {delCommunityPost, listCommunityPost, updateCommunityPost} from "@/api/cms/communityPost";
+import { ElMessageBox } from 'element-plus'
+
+const {proxy} = getCurrentInstance();
+
+const communityPostList = ref([]);
+const loading = ref(true);
+const total = ref(0);
+const daterangePublishTime = ref([]);
+
+const myCovers = import.meta.glob('@/assets/images/community/cover*.png', {eager: true, import: 'default'});
+
+let dragColor = null;
+
+function handleDragStart(e, color) {
+  dragColor = color;
+  e.dataTransfer.effectAllowed = 'copy';
+  e.dataTransfer.setData("text/plain", color);
+}
+
+function handleDrop(e) {
+  console.log('drop target:', e.target, 'tr:', e.target.closest('tr'));
+  if (!dragColor) {
+    return;
+  }
+
+  const tr = e.target.closest('tr');
+
+  if (!tr) {
+    return;
+  }
+
+  const matched = Array.from(tr.classList).find(name => name.startsWith('post-row-'));
+
+  if (!matched) {
+    dragColor = null;
+    return;
+  }
+
+  const id = matched.replace('post-row-', '');
+
+  updateCommunityPost({
+    id: id,
+    rowColor: dragColor
+  }).then(() => {
+    const target = communityPostList.value.find(item => String(item.id) === String(id))
+    if (target) {
+      target.rowColor = dragColor;
+    }
+    proxy.$modal.msgSuccess("修改成功");
+    getList();
+  });
+  dragColor = null;
+}
+
+// 红橙黄绿青蓝紫
+const colors = [
+  { label: '红', color: '#FF6961' },
+  { label: '橙', color: '#F1D8B1' },
+  { label: '黄', color: '#F7D774' },
+  { label: '绿', color: '#98FF98' },
+  { label: '青', color: '#87D3F8' },
+  { label: '蓝', color: '#ADD8E6' },
+  { label: '紫', color: '#B19CD9' }
+]
+
+const coverMaps = {};
+
+Object.keys(myCovers).forEach(key => {
+  coverMaps[key.split('/').pop()] = myCovers[key];
+});
+
+function coverUrl(url) {
+  return coverMaps[url] || '';
+}
+
+const data = reactive({
+  form: {},
+  queryParams: {
+    pageNum: 1,
+    pageSize: 10,
+  },
+  rules: {}
+});
+
+const {queryParams } = toRefs(data);
+
+/** 查询社区投稿列表 */
+function getList() {
+  loading.value = true;
+  queryParams.value.params = {};
+  if (null != daterangePublishTime && '' != daterangePublishTime) {
+    queryParams.value.params["beginPublishTime"] = daterangePublishTime.value[0];
+    queryParams.value.params["endPublishTime"] = daterangePublishTime.value[1];
+  }
+  listCommunityPost(queryParams.value).then(response => {
+    communityPostList.value = response.rows;
+    total.value = response.total;
+    loading.value = false;
+  });
+}
+
+function rowClassName({row}) {
+  return "post-row post-row-" + row.id;
+}
+
+function rowStyle({row}) {
+  return row.rowColor ? {background: row.rowColor} : {}
+}
+function handleDelete(row) {
+  ElMessageBox.confirm('是否删除' + row.id + '编号的帖子', '警告', {
+    confirmButtonText: '确定',
+    cancelButtonText: '取消',
+    type: 'warning'
+  }).then(() => {
+    return delCommunityPost(row.id)
+  }).then(() => {
+    getList()
+    proxy.$modal.msgSuccess('删除成功')
+  }).catch(() => {})
+}
+getList();
+</script>
