diff --git a/frontend_user/src/components/DragCard/index.vue b/frontend_user/src/components/DragCard/index.vue
new file mode 100644
index 0000000..b5ee208
--- /dev/null
+++ b/frontend_user/src/components/DragCard/index.vue
@@ -0,0 +1,177 @@
+<template>
+  <teleport to="body">
+    <div>
+      <!--  头像 -->
+      <div v-if="!chatOpen" class="avatar" :style="{
+            ...buttonPosition
+          }"
+           @mousedown.prevent="handleMouseDown"
+           ref="dragButton"
+      >
+        <img :style="{
+        height: buttonHeight + 'px',
+        width: buttonWidth + 'px',
+        userSelect: 'none',
+        pointerEvents: 'none',
+        }"
+             src="@/assets/images/pic5.png" alt=""
+        />
+      </div>
+
+    </div>
+  </teleport>
+</template>
+
+<script>
+import {mapGetters} from 'vuex'
+import Chat from '@/components/Chat/index.vue'
+
+export default {
+  name: 'DragButton',
+  components: {
+    Chat
+  },
+  props: {
+    // 通过position来设置初始定位
+    position: {
+      type: Object,
+      default: () => {
+        return {
+          top: 'auto',
+          left: 'auto',
+          button: '20vh',
+          right: '0'
+        }
+      }
+    }
+  },
+  data() {
+    return {
+      chatOpen: false,     //  菜单展开状态
+
+      mouseDownState: false,   //  鼠标点击状态
+
+      buttonHeight: 50,
+      buttonWidth: 50,
+      buttonPosition: {
+        top: 'auto',
+        left: 'auto',
+        button: '20vh',
+        right: '0'
+      },
+      currentMouseX: 0,
+      currentMouseY: 0,
+
+      documentWidth: document.documentElement.clientWidth
+    }
+  },
+  computed: {
+    ...mapGetters(['userId', 'avatar', 'name'])
+  },
+  methods: {
+    // 最小化
+    minimize() {
+      this.chatOpen = false
+    },
+
+    //  鼠标按下
+    handleMouseDown(event) {
+      /* 此处判断  pc 或 移动端 得到 event 事件 */
+      let touch
+      if (event.touches) {
+        touch = event.touches[0]
+      } else {
+        touch = event
+      }
+      //得到鼠标的位置
+      let {clientX, clientY} = touch
+
+      // 保存当前位置
+      this.currentMouseX = clientX
+      this.currentMouseY = clientY
+
+      this.mouseDownState = true
+      //如果用户没有登录的 需要跳转到登录页面
+      setTimeout(() => {
+        if (!this.mouseDownState) {
+          console.log(this.userId)
+
+          if (this.userId !== '') {
+            this.chatOpen = true
+          } else {
+            this.$router.push('/login')
+          }
+          this.chatOpen = true
+        }
+      }, 100)
+
+      document.documentElement.addEventListener('mousemove', this.handleMouseMove)
+      document.documentElement.addEventListener('mouseup', this.handleMouseUp)
+    },
+
+    //  鼠标拖拽
+    handleMouseMove(event) {
+      // 如果没有鼠标点击状态  则不执行
+      if (!this.mouseDownState) return
+      // 阻止默认事件
+      event.preventDefault()
+
+      let touch
+      if (event.touches) {
+        touch = event.touches[0]
+      } else {
+        touch = event
+      }
+      let {clientX, clientY} = touch
+
+      // 当前位置增加偏移量
+      this.buttonPosition.left = `${this.$refs.dragButton.offsetLeft + (clientX - this.currentMouseX)}px`
+      this.buttonPosition.top = `${this.$refs.dragButton.offsetTop + (clientY - this.currentMouseY)}px`
+      this.buttonPosition.bottom = 'auto'
+      this.buttonPosition.right = 'auto'
+
+      this.currentMouseX = clientX
+      this.currentMouseY = clientY
+    },
+    //    鼠标抬起
+    handleMouseUp(event) {
+      if (!this.$refs.dragButton) return
+      // 如果没有鼠标点击状态  则不执行
+      if (!this.mouseDownState) return
+
+      let {clientWidth: pageWidth} = document.documentElement
+      let {clientWidth: dragButtonWidth} = this.$refs.dragButton
+
+      if (this.currentMouseX <= ((pageWidth - dragButtonWidth) / 2)) {
+        this.buttonPosition.left = '0px'
+        this.buttonPosition.right = 'auto'
+      } else {
+        this.buttonPosition.right = '0px'
+        this.buttonPosition.left = 'auto'
+      }
+
+      this.mouseDownState = false
+
+      document.documentElement.removeEventListener('mousemove', this.handleMouseMove)
+      document.documentElement.removeEventListener('mouseup', this.handleMouseUp)
+    },
+
+    setDocumentWidth() {
+      this.documentWidth = document.documentElement.offsetWidth
+    },
+  },
+  mounted() {
+    window.addEventListener('resize', this.setDocumentWidth)
+
+    this.buttonPosition = {...this.buttonPosition, ...this.position}
+  },
+  beforeDestroy() {
+    window.removeEventListener('resize', this.setDocumentWidth)
+  }
+
+}
+</script>
+
+<style scoped lang="scss">
+
+</style>
diff --git a/frontend_user/src/views/community/components/DraggableCard.vue b/frontend_user/src/views/community/components/DraggableCard.vue
new file mode 100644
index 0000000..eb0682d
--- /dev/null
+++ b/frontend_user/src/views/community/components/DraggableCard.vue
@@ -0,0 +1,246 @@
+<template>
+  <div ref="slotRef" class="dc-slot">
+    <teleport to="body">
+      <div v-show="ready" class="dc-card" :class="{ 'is-dragging': dragging }" :style="cardStyle">
+        <div class="dc-head" @mousedown.prevent="onHeadDown">
+          <slot name="header">
+            <span class="dc-title">{{ label }}</span>
+          </slot>
+          <span class="dc-grip" title="按住此处可拖动">⋮⋮</span>
+        </div>
+        <div class="dc-body">
+          <slot></slot>
+        </div>
+      </div>
+
+      <div v-if="hidden" class="dc-strip" :class="'dc-strip--' + snap" :style="stripStyle" @click="expand">
+        <span class="dc-strip-text">{{ label }}</span>
+      </div>
+    </teleport>
+  </div>
+</template>
+
+<script setup>
+defineProps({
+  label: { type: String, default: '面板' }
+})
+
+const slotRef = ref(null)
+const ready = ref(false)
+const dragging = ref(false)
+const hidden = ref(false)
+const snap = ref(null)
+
+const x = ref(0)
+const y = ref(0)
+const width = ref(0)
+const height = ref(0)
+const edgeTop = ref(0)
+
+let startX = 0
+let startY = 0
+let startLeft = 0
+let startTop = 0
+let moved = false
+
+const viewportW = () => document.documentElement.clientWidth
+const viewportH = () => document.documentElement.clientHeight
+const SNAP_GAP = 50
+const STRIP_SIZE = 16
+
+const cardStyle = computed(() => ({
+  left: `${x.value}px`,
+  top: `${y.value}px`,
+  width: `${width.value}px`,
+  height: `${height.value}px`,
+  transition: dragging.value ? 'none' : 'left .25s ease, top .25s ease'
+}))
+
+const stripStyle = computed(() => ({
+  top: `${y.value + 24}px`,
+  height: `${Math.min(120, Math.max(84, height.value - 48))}px`
+}))
+
+function initPosition() {
+  if (!slotRef.value) return
+  const rect = slotRef.value.getBoundingClientRect()
+  if (!rect.width) return
+  width.value = rect.width
+  height.value = rect.height
+  x.value = rect.left
+  y.value = rect.top
+  ready.value = true
+}
+
+function onResize() {
+  if (hidden.value) {
+    if (snap.value === 'right') x.value = viewportW() - STRIP_SIZE - width.value + STRIP_SIZE
+    return
+  }
+  if (!moved) {
+    initPosition()
+    return
+  }
+  x.value = Math.max(0, Math.min(x.value, viewportW() - width.value))
+  y.value = Math.max(0, Math.min(y.value, viewportH() - 90))
+}
+
+function onHeadDown(e) {
+  if (hidden.value) return
+  dragging.value = true
+  startX = e.clientX
+  startY = e.clientY
+  startLeft = x.value
+  startTop = y.value
+  document.documentElement.addEventListener('mousemove', onMouseMove)
+  document.documentElement.addEventListener('mouseup', onMouseUp)
+}
+
+function onMouseMove(e) {
+  if (!dragging.value) return
+  moved = true
+  const vw = viewportW()
+  const vh = viewportH()
+  let left = startLeft + (e.clientX - startX)
+  let top = startTop + (e.clientY - startY)
+
+  top = Math.max(0, Math.min(top, vh - 90))
+
+  if (left <= SNAP_GAP) {
+    left = 0
+    snap.value = 'left'
+  } else if (left + width.value >= vw - SNAP_GAP) {
+    left = vw - width.value
+    snap.value = 'right'
+  } else {
+    snap.value = null
+  }
+
+  x.value = left
+  y.value = top
+}
+
+function onMouseUp() {
+  if (!dragging.value) return
+  dragging.value = false
+  document.documentElement.removeEventListener('mousemove', onMouseMove)
+  document.documentElement.removeEventListener('mouseup', onMouseUp)
+
+  if (snap.value === 'left') {
+    edgeTop.value = y.value
+    hidden.value = true
+    x.value = STRIP_SIZE - width.value
+  } else if (snap.value === 'right') {
+    edgeTop.value = y.value
+    hidden.value = true
+    x.value = viewportW() - STRIP_SIZE
+  }
+}
+
+function expand() {
+  if (!hidden.value) return
+  y.value = edgeTop.value
+  x.value = snap.value === 'left' ? 0 : viewportW() - width.value
+  hidden.value = false
+}
+
+onMounted(() => {
+  initPosition()
+  window.addEventListener('resize', onResize)
+})
+
+onBeforeUnmount(() => {
+  window.removeEventListener('resize', onResize)
+  document.documentElement.removeEventListener('mousemove', onMouseMove)
+  document.documentElement.removeEventListener('mouseup', onMouseUp)
+})
+</script>
+
+<style scoped>
+.dc-slot {
+  height: 100%;
+  min-width: 0;
+}
+
+.dc-card {
+  position: fixed;
+  z-index: 1000;
+  display: flex;
+  flex-direction: column;
+  background: #ffffff;
+  border-radius: 12px;
+  box-shadow: 0 4px 20px rgba(20, 60, 100, 0.08);
+  overflow: hidden;
+}
+
+.dc-card.is-dragging {
+  box-shadow: 0 12px 32px rgba(20, 60, 100, 0.22);
+  cursor: grabbing;
+}
+
+.dc-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  height: 46px;
+  padding: 0 16px;
+  border-bottom: 1px solid #f0f2f5;
+  cursor: grab;
+  user-select: none;
+  flex-shrink: 0;
+}
+
+.dc-head:active {
+  cursor: grabbing;
+}
+
+.dc-title {
+  font-size: 15px;
+  font-weight: 600;
+  color: #24303f;
+}
+
+.dc-grip {
+  color: #c0c8d4;
+  font-size: 13px;
+  letter-spacing: -2px;
+}
+
+.dc-body {
+  flex: 1;
+  min-height: 0;
+  overflow: auto;
+  padding: 14px 16px 18px;
+}
+
+.dc-strip {
+  position: fixed;
+  z-index: 1001;
+  width: 16px;
+  background: #ffffff;
+  border: 1px solid #e6ebf2;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  border-radius: 0 8px 8px 0;
+  box-shadow: 2px 0 10px rgba(20, 60, 100, 0.1);
+}
+
+.dc-strip--left {
+  left: 0;
+}
+
+.dc-strip--right {
+  right: 0;
+  border-radius: 8px 0 0 8px;
+}
+
+.dc-strip-text {
+  writing-mode: vertical-rl;
+  font-size: 12px;
+  letter-spacing: 4px;
+  color: #1a6dff;
+  user-select: none;
+}
+</style>
diff --git a/frontend_user/src/views/community/detail.vue b/frontend_user/src/views/community/detail.vue
new file mode 100644
index 0000000..948c826
--- /dev/null
+++ b/frontend_user/src/views/community/detail.vue
@@ -0,0 +1,190 @@
+<template>
+  <div class="community-detail">
+    <div class="detail-card" v-loading="loading">
+      <div class="detail-head">
+        <el-button text icon="ArrowLeft" class="back-btn" @click="goBack">返回</el-button>
+        <el-tag v-if="post.categoryName" size="small" effect="plain">{{ post.categoryName }}</el-tag>
+      </div>
+
+      <h1 class="detail-title">{{ post.title }}</h1>
+      <div class="detail-meta">
+        <span class="detail-author">{{ post.author || '匿名' }}</span>
+        <span class="detail-divider">·</span>
+        <span>{{ formatTime(post.publishTime || post.createTime) }}</span>
+        <span class="detail-stat"><el-icon :size="13"><View /></el-icon>{{ post.viewCount || 0 }}</span>
+        <span class="detail-stat"><el-icon :size="13"><Star /></el-icon>{{ post.likeCount || 0 }}</span>
+      </div>
+
+      <img v-if="post.coverUrl" class="detail-cover" :src="coverUrl" alt="" />
+
+      <p v-if="post.summary" class="detail-summary">{{ post.summary }}</p>
+
+      <div class="detail-content" v-html="safeContent"></div>
+
+      <div class="detail-actions">
+        <el-button type="primary" plain @click="like" :disabled="liked">{{ liked ? '已点赞' : '点赞' }}</el-button>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup name="CommunityDetail">
+import { computed, onMounted } from 'vue'
+import { useRoute, useRouter } from 'vue-router'
+import { ElMessage } from 'element-plus'
+import { getCommunityPostFront } from '@/api/cms/community'
+import { parseTime } from '@/utils/neu'
+
+const route = useRoute()
+const router = useRouter()
+const loading = ref(true)
+const post = ref({})
+const liked = ref(false)
+
+const coverModules = import.meta.glob('@/assets/images/community/cover*.png', { eager: true, import: 'default' })
+const coverMap = {}
+Object.keys(coverModules).forEach(key => {
+  coverMap[key.split('/').pop()] = coverModules[key]
+})
+
+const coverUrl = computed(() => {
+  const url = post.value.coverUrl
+  if (!url) return ''
+  if (/^https?:\/\//.test(url) || url.startsWith('data:')) return url
+  return coverMap[url.split('/').pop()] || ''
+})
+
+const safeContent = computed(() => {
+  const content = post.value.content || ''
+  return content.replace(/<script[\s\S]*?<\/script>/gi, '')
+})
+
+function formatTime(time) {
+  return time ? parseTime(time, '{y}-{m}-{d} {h}:{i}') : ''
+}
+
+function goBack() {
+  router.back()
+}
+
+function like() {
+  liked.value = true
+  post.value.likeCount = (post.value.likeCount || 0) + 1
+  ElMessage.success('点赞成功')
+}
+
+onMounted(() => {
+  const id = route.query.id
+  if (!id) {
+    loading.value = false
+    return
+  }
+  getCommunityPostFront(id).then(res => {
+    post.value = res.data || {}
+    loading.value = false
