+<template>
+  <div class="community-index">
+    <draggable-card class="cat-panel" label="社区分类">
+      <ul class="category-list">
+        <li
+          v-for="item in categoryList"
+          :key="item.id"
+          class="category-item"
+          :class="{ active: activeCategoryId === item.id }"
+          @click="handleCategoryClick(item)"
+        >
+          <el-icon class="category-icon" :size="18"><component :is="iconOf(item.icon)" /></el-icon>
+          <span class="category-name">{{ item.name }}</span>
+        </li>
+      </ul>
+    </draggable-card>
+
+    <draggable-card class="post-panel" label="用户社区帖子">
+      <div class="post-toolbar">
+        <div class="post-tabs">
+          <span
+            v-for="tab in tabs"
+            :key="tab.value"
+            class="post-tab"
+            :class="{ active: orderType === tab.value }"
+            @click="handleTabChange(tab.value)"
+          >{{ tab.label }}</span>
+        </div>
+        <div class="post-search">
+          <el-input v-model="keyword" size="small" placeholder="搜索帖子" clearable @keyup.enter="handleSearch" />
+          <el-button type="primary" size="small" @click="handleSearch">搜索</el-button>
+        </div>
+      </div>
+
+      <div v-loading="postLoading" class="post-list">
+        <el-empty v-if="!postLoading && postList.length === 0" description="暂无帖子" />
+        <div
+          v-for="post in postList"
+          :key="post.id"
+          class="post-item"
+          @click="goDetail(post)"
+        >
+          <div class="post-main">
+            <div class="post-header">
+              <span class="post-title">{{ post.title }}</span>
+              <el-tag v-if="activeType === '关注'" size="small" effect="plain" class="post-tag">{{ post.categoryName }}</el-tag>
+            </div>
+            <p class="post-summary">{{ post.summary }}</p>
+            <div class="post-meta">
+              <span class="post-author">{{ post.author }}</span>
+              <span class="post-divider">·</span>
+              <span>{{ formatTime(post.publishTime) }}</span>
+              <span class="post-stat">
+                <el-icon :size="13"><View /></el-icon>{{ post.viewCount || 0 }}
+              </span>
+              <span class="post-stat">
+                <el-icon :size="13"><Star /></el-icon>{{ post.likeCount || 0 }}
+              </span>
+            </div>
+          </div>
+          <img v-if="post.coverUrl" class="post-cover" :src="coverUrl(post.coverUrl)" alt="" />
+        </div>
+      </div>
+
+      <div class="post-footer">
+        <el-pagination
+          v-model:current-page="queryParams.pageNum"
+          v-model:page-size="queryParams.pageSize"
+          :total="total"
+          :page-sizes="[10, 20, 30]"
+          layout="total, prev, pager, next"
+          small
+          background
+          @current-change="getPostList"
+        />
+      </div>
+    </draggable-card>
+
+    <draggable-card class="hot-panel" label="热门文章">
+      <ul class="hot-list">
+        <li v-for="(item, index) in hotList" :key="item.id" class="hot-item" @click="goDetail(item)">
+          <span class="hot-rank" :class="'hot-rank-' + (index + 1)">top{{ index + 1 }}</span>
+          <span class="hot-title">{{ item.title }}</span>
+        </li>
+        <el-empty v-if="hotList.length === 0" description="暂无数据" :image-size="60" />
+      </ul>
+    </draggable-card>
+
+    <div
+      class="float-lock"
+      :style="{ left: floatPos.left + 'px', top: floatPos.top + 'px' }"
+      title="左键拖动 / 右键锁定屏幕"
+      @mousedown.prevent="onFloatDown"
+      @contextmenu.prevent="lockScreen"
+    >
+      <el-icon :size="20"><Lock /></el-icon>
+    </div>
+
+    <teleport to="body">
+      <div v-if="locked" class="lock-screen">
+        <img :src="lockImage" alt="" class="lock-image" />
+        <p class="lock-tip">屏幕已锁定，按下 ESC 解锁</p>
+      </div>
+    </teleport>
+  </div>
+</template>
+
+<script setup name="CommunityIndex">
+import { onActivated, onBeforeUnmount, onMounted } from 'vue'
+import { useRouter } from 'vue-router'
+import * as ElIcons from '@element-plus/icons-vue'
+import { listCommunityCategoryFront, listCommunityPostFront, listCommunityPostHot } from '@/api/cms/community'
+import { parseTime } from '@/utils/neu'
+import DraggableCard from './components/DraggableCard.vue'
+import lockImage from '@/assets/images/XN06.png'
+
+const coverModules = import.meta.glob('@/assets/images/community/cover*.png', { eager: true, import: 'default' })
+const coverMap = {}
+Object.keys(coverModules).forEach(key => {
+  const fileName = key.split('/').pop()
+  coverMap[fileName] = coverModules[key]
+})
+
+const router = useRouter()
+
+const DEFAULT_ICON = 'Grid'
+const categoryList = ref([])
+const activeCategoryId = ref(null)
+const activeType = ref('发现')
+const orderType = ref('recommend')
+const keyword = ref('')
+const postList = ref([])
+const hotList = ref([])
+const postLoading = ref(false)
+const total = ref(0)
+
+const tabs = [
+  { label: '推荐', value: 'recommend' },
+  { label: '最新', value: 'latest' }
+]
+
+const queryParams = reactive({
+  pageNum: 1,
+  pageSize: 10,
+  categoryId: null,
+  orderType: 'recommend',
+  keyword: null
+})
+
+function iconOf(name) {
+  return ElIcons[name] || ElIcons[DEFAULT_ICON]
+}
+
+function formatTime(time) {
+  return time ? parseTime(time, '{y}-{m}-{d} {h}:{i}') : ''
+}
+
+function coverUrl(url) {
+  if (!url) return ''
+  if (/^https?:\/\//.test(url) || url.startsWith('data:')) return url
+  const fileName = url.split('/').pop()
+  return coverMap[fileName] || ''
+}
+
+function getCategoryList() {
+  listCommunityCategoryFront().then(res => {
+    categoryList.value = res.data || []
+    const found = categoryList.value.find(item => item.name === '发现') || categoryList.value[0]
+    if (found) {
+      handleCategoryClick(found)
+    } else {
+      getPostList()
+    }
+  })
+}
+
+function getPostList() {
+  queryParams.categoryId = activeCategoryId.value
+  queryParams.orderType = orderType.value
+  queryParams.keyword = keyword.value || null
+  postLoading.value = true
+  listCommunityPostFront(queryParams).then(res => {
+    postList.value = res.rows || []
+    total.value = res.total || 0
+    postLoading.value = false
+  }).catch(() => {
+    postLoading.value = false
+  })
+}
+
+function getHotList() {
+  listCommunityPostHot().then(res => {
+    hotList.value = (res.data || []).slice(0, 10)
+  })
+}
+
+function handleCategoryClick(item) {
+  activeCategoryId.value = item.id
+  activeType.value = item.name
+  queryParams.pageNum = 1
+  getPostList()
+}
+
+function handleTabChange(value) {
+  if (orderType.value === value) return
+  orderType.value = value
+  queryParams.pageNum = 1
+  getPostList()
+}
+
+function handleSearch() {
+  queryParams.pageNum = 1
+  getPostList()
+}
+
+function goDetail(post) {
+  if (!post || !post.id) return
+  router.push({ path: '/community/detail', query: { id: String(post.id) } })
+}
+
+const floatPos = reactive({ left: 0, top: 0 })
+let floatDragging = false
+let floatMoved = false
+let floatStartX = 0
+let floatStartY = 0
+
+function resetFloatPosition() {
+  const vw = document.documentElement.clientWidth
+  const vh = document.documentElement.clientHeight
+  floatPos.left = vw - 60
+  floatPos.top = vh - 60
+}
+
+function onFloatDown(e) {
+  floatStartX = e.clientX
+  floatStartY = e.clientY
+  floatDragging = true
+  floatMoved = false
+  floatPos.left = e.clientX - 20
+  floatPos.top = e.clientY - 20
+  document.documentElement.addEventListener('mousemove', onFloatMove)
+  document.documentElement.addEventListener('mouseup', onFloatUp)
+}
+
+function onFloatMove(e) {
+  if (!floatDragging) return
+  if (Math.abs(e.clientX - floatStartX) > 3 || Math.abs(e.clientY - floatStartY) > 3) {
+    floatMoved = true
+  }
+  const vw = document.documentElement.clientWidth
+  const vh = document.documentElement.clientHeight
+  floatPos.left = Math.max(0, Math.min(e.clientX - 20, vw - 40))
+  floatPos.top = Math.max(0, Math.min(e.clientY - 20, vh - 40))
+}
+
+function onFloatUp(e) {
+  if (!floatDragging) return
+  document.documentElement.removeEventListener('mousemove', onFloatMove)
+  document.documentElement.removeEventListener('mouseup', onFloatUp)
+  if (!floatMoved) {
+    floatPos.left = floatStartX - 20
+    floatPos.top = floatStartY - 20
+  }
+  floatDragging = false
+}
+
+const locked = ref(false)
+
+function lockScreen() {
+  locked.value = true
+}
+
+function onKeyDown(e) {
+  if (e.key === 'Escape' && locked.value) {
+    locked.value = false
+  }
+}
+
+function reloadAll() {
+  getPostList()
+  getHotList()
+}
+
+onMounted(() => {
+  resetFloatPosition()
+  getCategoryList()
+  getHotList()
+  window.addEventListener('keydown', onKeyDown)
+})
+
+onActivated(() => {
+  reloadAll()
+})
+
+onBeforeUnmount(() => {
+  window.removeEventListener('keydown', onKeyDown)
+  document.documentElement.removeEventListener('mousemove', onFloatMove)
+  document.documentElement.removeEventListener('mouseup', onFloatUp)
+})
+</script>
